// MinimalPhigrosRend config v2 (JSON with comments)
//
// Basic usage (legacy Python renderer):
//   python3 -m phic_renderer --input <chart_or_pack> --config <this_file>
//   python3 -m phic_renderer --input <chart_or_pack> --save_config config.jsonc
//
// Basic usage (legacy C++ CLI; build with -DBUILD_LEGACY_CLI=ON):
//   phigros_render <chart_path> --config <this_file>
//
// Notes:
// - Lines starting with // or # are comments.
// - CLI args override config values.
// - For SDL app and legacy C++ render options see docs/CPP_RENDERER.md
{
  "version": 2,
  "window": {
    "w": 1280,
    "h": 720
  },
  "render": {
    "backend": "pygame",
    "approach": 3.0,
    "chart_speed": 1.0,
    "no_cull": false,
    "no_cull_screen": false,
    "no_cull_enter_time": true,
    "expand": 1.0,
    "note_scale_x": 2.5,
    "note_scale_y": 1.0,
    "note_flow_speed_multiplier": 1.0,
    "font_align": true,
    "overrender": 1.0,
    "trail_alpha": 0.3,
    "trail_blur": 1,
    "trail_dim": 60,
    "trail_frames": 1,
    "trail_decay": 0.85,
    "trail_blend": "normal",
    "trail_blur_ramp": false,
    "hitfx_scale_mul": 0.75,
    "multicolor_lines": false,
    "note_outline": false,
    "line_alpha_affects_notes": "negative_only"
  },
  "audio": {
    "audio_backend": "pygame",
    "bgm": "charts/ERABYECONNEC10N.かめりあ/ERABYECONNEC10N.かめりあ.ogg",
    "force": false,
    "bgm_volume": 0.8,
    "hitsound_min_interval_ms": 30
  },
  "assets": {
    "respack": "./respack.zip",
    "bg": "charts/ERABYECONNEC10N.かめりあ/ERABYECONNEC10N.かめりあ.png",
    "bg_blur": 10,
    "bg_dim": 120
  },
  "gameplay": {
    "autoplay": true,
    "mode": "autoplay",
    "simulateplay": {
      "enabled": false,
      "mode": "aggressive",
      "max_pointers": 4,
      "jitter_ms": 12.0,
      "render_pointer": true,
      "render_trail": true,
      "trail_seconds": 0.16,
      "cursor_radius_px": 20.0
    },
    "simulateplay_ipad": false,
    "ipad_bundle_id": null,
    "ipad_udid": null,
    "ipad_device_name": "iPad",
    "ipad_appium_server": "http://127.0.0.1:4723",
    "ipad_mjpeg_url": null,
    "ipad_move_hz": 25.0,
    "ipad_preview_fps": 15.0,
    "ipad_max_retries": 2,
    "ipad_retry_backoff_s": 0.35,
    "ipad_reconnect": false,
    "ipad_activate_app": false,
    "ipad_viewport_x0": 0.0,
    "ipad_viewport_y0": 0.0,
    "ipad_viewport_x1": 1.0,
    "ipad_viewport_y1": 1.0,
    "judge_script": null,
    "hold_fx_interval_ms": 200,
    "hold_tail_tol": 0.8,
    "judge_width": 0.12,
    "judge_height": 0.06,
    "flick_threshold": 0.02,
    "start_time": null,
    "end_time": null
  },
  "ui": {
    "lang": "en",
    "no_title_overlay": false,
    "font_path": null,
    "font_size_multiplier": 1.5,
    "advance_lazy_load": false,
    "advance_lazy_cache": 1,
    "advance_lazy_preload": false,
    "advance_lazy_scan_total_notes": false
  },
  "rpe": {
    "rpe_easing_shift": 0
  },
  "debug": {
    "basic_debug": false,
    "debug_line_label": false,
    "debug_line_stats": false,
    "debug_judge_windows": false,
    "debug_pointer": true,
    "debug_note_info": false,
    "debug_particles": false
  },
  "mods": {
    "hold_to_tap_drag": {
      "enable": false,
      "interval": 0.1,
      "tap_head": true,
      "remove_hold": true,
      "include_end": true,
      "drag_kind": "tap"
    },
    "attach": {
      "enable": false,
      "kind": 4,
      "x_offset": 80,
      "y_offset": 0,
      "time_offset": 0.0,
      "above": null,
      "filter": {
        "kinds": [
          1,
          2
        ]
      }
    },
    "full_blue": {
      "enable": true
    }
  }
}
